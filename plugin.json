{
  "workflow": {
    "nodes": [
      {
        "id": "plugin-metadata",
        "type": "modifier",
        "position": {
          "x": 240,
          "y": 160
        },
        "data": {
          "modifier": {
            "name": "Dislocation Analysis (Experimental)",
            "key": "opendxa",
            "icon": "HiCube",
            "author": "Rodolfo Herrera",
            "license": "MIT",
            "version": "2.0.4",
            "homepage": "https://github.com/rodyherrera/Volterra",
            "description": "Analisis de dislocaciones a partir del algoritmo de identificacion de estructura seleccionado por el usuario."
          }
        }
      },
      {
        "id": "trajectory-context",
        "type": "context",
        "position": {
          "x": 816,
          "y": 160
        },
        "data": {
          "context": {
            "source": "trajectory_dumps"
          }
        }
      },
      {
        "id": "foreach-trajectory-dumps",
        "type": "forEach",
        "position": {
          "x": 1088,
          "y": 208
        },
        "data": {
          "forEach": {
            "iterableSource": "{{ trajectory-context.trajectory_dumps }}"
          }
        }
      },
      {
        "id": "analysis-entrypoint",
        "type": "entrypoint",
        "position": {
          "x": 1696,
          "y": 208
        },
        "data": {
          "entrypoint": {
            "type": "packaged-executable",
            "binary": "opendxa-plugin.zip",
            "binaryObjectPath": "__UPLOAD_BINARY_OBJECT_PATH__",
            "binaryFileName": "opendxa-plugin.zip",
            "entrypointScript": "bin/opendxa",
            "requirementsFile": "",
            "arguments": "{{ foreach-trajectory-dumps.currentValue.path }} {{ foreach-trajectory-dumps.outputPath }}",
            "timeout": -1
          }
        }
      },
      {
        "id": "primary-exposure",
        "type": "exposure",
        "position": {
          "x": 2016,
          "y": 208
        },
        "data": {
          "exposure": {
            "name": "Dislocations",
            "icon": "HiCube",
            "results": "dislocations.parquet",
            "iterable": "",
            "properties": [
              {
                "key": "burgers_family",
                "label": "Burgers family",
                "type": "string"
              },
              {
                "key": "burgers_family_label",
                "label": "Burgers family (label)",
                "type": "string"
              },
              {
                "key": "crystal_structure",
                "label": "Crystal structure",
                "type": "string"
              },
              {
                "key": "length",
                "label": "Segment length",
                "type": "number"
              },
              {
                "key": "magnitude",
                "label": "Burgers magnitude",
                "type": "number"
              },
              {
                "key": "cluster_id",
                "label": "Cluster",
                "type": "number"
              }
            ]
          }
        }
      },
      {
        "id": "primary-export",
        "type": "export",
        "position": {
          "x": 2336,
          "y": 208
        },
        "data": {
          "export": {
            "exporter": "LineExporter",
            "type": "glb",
            "options": {
              "lineWidth": 0.8,
              "colorBy": "burgers_family",
              "propertyColors": {
                "Other": [
                  0.9,
                  0.2,
                  0.2,
                  1.0
                ],
                "1/2<110>": [
                  0.2,
                  0.2,
                  1.0,
                  1.0
                ],
                "1/6<112>": [
                  0.0,
                  1.0,
                  0.0,
                  1.0
                ],
                "1/6<110>": [
                  1.0,
                  0.0,
                  1.0,
                  1.0
                ],
                "1/3<100>": [
                  1.0,
                  1.0,
                  0.0,
                  1.0
                ],
                "1/3<111>": [
                  0.0,
                  1.0,
                  1.0,
                  1.0
                ],
                "1/2<111>": [
                  0.2,
                  0.95,
                  0.2,
                  1.0
                ],
                "<100>": [
                  1.0,
                  0.3,
                  0.8,
                  1.0
                ],
                "<110>": [
                  0.2,

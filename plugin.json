                  1.0
                ],
                "<111>": [
                  1.0,
                  0.8,
                  0.2,
                  1.0
                ],
                "1/3<1-210>": [
                  0.0,
                  1.0,
                  0.0,
                  1.0
                ],
                "1/3<1-100>": [
                  1.0,
                  0.0,
                  1.0,
                  1.0
                ],
                "<0001>": [
                  1.0,
                  0.3,
                  0.8,
                  1.0
                ],
                "1/2<0001>": [
                  1.0,
                  1.0,
                  0.0,
                  1.0
                ],
                "1/3<1-213>": [
                  0.0,
                  1.0,
                  1.0,
                  1.0

  "interface": {
    "version": 2,
    "requires": [
      {
        "id": "structure",
        "capability": "volt/structure-identification@1",
        "bind": {
          "clusters_table": "--clusters_table",
          "cluster_transitions": "--clusters_transitions",
          "neighbor_lattice": "--neighbor_lattice"
        }
      }
    ],
    "input": {
      "from": "structure",
      "port": "annotated_dump"
    },
    "provides": {
      "volt/dislocation-network@1": {
        "dislocations": "dislocations.parquet"
      },
      "volt/per-atom-properties@1": {
        "atoms": "atoms.parquet"
      }
    }
  }
}
